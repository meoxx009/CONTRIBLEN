# ==============================================================================
# ContriBLens OSS — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In production (e.g., Vercel), configure these variables in the project settings.
# NEVER commit real credentials or keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# Base URL of the deployed application (used for redirects, metadata, and auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Authentication & Persistent Database)
# ------------------------------------------------------------------------------
# Found in your Supabase project dashboard: Settings > API
# Public URL of your Supabase instance (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key for client-side queries (safe for browser, guarded by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only service role key with elevated permissions (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Google Gemini API (AI Explanations & Grounded Route Generation)
# ------------------------------------------------------------------------------
# Google AI Studio API key (server-only)
# If omitted or disabled, ContriBLens automatically uses deterministic fallback engines.
GEMINI_API_KEY=your-gemini-api-key-here

# Target Gemini model (default: gamma-4 or gemini-2.5-flash)
GEMINI_MODEL=gamma-4

# Timeout for AI requests in milliseconds (default: 15000)
GEMINI_API_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 4. GitHub API (Higher Rate Limits for Repository Scanning)
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (classic or fine-grained with public read-only access)
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr.
GITHUB_TOKEN=your-github-personal-access-token-here

# ------------------------------------------------------------------------------
# 5. Local Authentication & Session Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies in local development / dual-auth mode
JWT_SECRET=your-secure-random-jwt-secret-here

# ------------------------------------------------------------------------------
# 6. Repository Scanner Bounds (Safety & Resource Limits)
# ------------------------------------------------------------------------------
# Maximum files indexed per repository scan (default: 60)
SCAN_MAX_FILES=60

# Maximum size per individual file in bytes (default: 180000 = 180 KB)
SCAN_MAX_FILE_BYTES=180000

# Maximum total repository bytes analyzed (default: 3000000 = 3 MB)
SCAN_MAX_TOTAL_BYTES=3000000

# Maximum Git tree entries traversed (default: 20000)
SCAN_MAX_TREE_ENTRIES=20000

# ------------------------------------------------------------------------------
# 7. Feature Toggles
# ------------------------------------------------------------------------------
# Enable or disable Gemini AI calls (true/false)
ENABLE_GEMINI=true

# Enable or disable OSV.dev vulnerability queries (true/false)
ENABLE_OSV=true

# Enable demo mode with preloaded walkthrough data (true/false)
ENABLE_DEMO_MODE=false
