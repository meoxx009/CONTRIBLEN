{
  "name": "contriblens",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) {}\"",
    "predev": "npm run clean",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/run-tests.mjs",
    "test:scanner": "node --experimental-strip-types test/security-scanner.test.mjs",
    "check:integrations": "node --experimental-strip-types scripts/check-integrations.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
